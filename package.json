{
  "name": "agent-orchestrator-console",
  "private": true,
  "version": "0.1.0",
  "description": "Configurable Multi-Agent Orchestrator Console with chat, cron, heartbeats and SQLite persistence",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "node server/src/index.js",
    "test": "npm --workspace server test",
    "oil-changes": "node server/src/oil-change-cli.js",
    "oil-mcp": "node server/src/mcp/oil-mcp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
